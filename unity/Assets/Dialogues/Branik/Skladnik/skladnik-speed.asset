  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: skladnik-speed
  m_EditorClassIdentifier: 
  entryLines:
  - text: "\u010Cau L\xE1\u010Fo, jak se vede?"
    speakerName: Branice
  - text: "Nazdar ty holka zlat\xE1, sice toho moc nevyr\xE1b\xEDme ale j\xE1 si
      pr\xE1ci v\u017Edycky najdu. Akor\xE1t u\u017E m\u011B za\u010D\xEDnaj\xED
      bolet z\xE1da."
    speakerName: "Skladn\xEDk L\xE1\u010Fa"
  - text: "Tak ty m\u011B bol\xED u\u017E bol\xED taky."
    speakerName: Branice
  - text: "V\xED\u0161 co na to pom\u016F\u017Ee? M\xE1m tady je\u0161t\u011B p\xE1r
      svi\u017En\u011Bj\u0161\xEDch pivn\xEDch kousk\u016F, kter\xE9 mi v\u017Edy
      zlep\u0161\xED n\xE1ladu. Jestli chce\u0161, jeden ti d\xE1m."
    speakerName: "Skladn\xEDk L\xE1\u010Fa"
  choices:
  - choiceText: "Jasn\u011B, r\xE1da to vyzkou\u0161\xEDm."
    isEnding: 1
    output: giveSpeedPotion
    dialogue:
    - text: "To zkus\xEDm velmi r\xE1da, d\xEDky moc."
      speakerName: Branice
    - text: "M\u016F\u017Ee\u0161 ho pou\u017E\xEDt pomoc\xED kl\xE1vesy W a na chv\xEDli
        ti dvojn\xE1sobn\u011B zv\xFD\u0161\xED rychlost pohybu."
      speakerName: "Skladn\xEDk L\xE1\u010Fa"
  - choiceText: "Nechci, j\xE1 piju z\xE1sadn\u011B jen bran\xED\u010Dek."
    isEnding: 0
    output: 
    dialogue:
    - text: 
      speakerName: 
  participantPortrait: {fileID: 21300000, guid: 971d118c7cae7a34fa4de276e339f7b3, type: 3}
  monologue: 0
