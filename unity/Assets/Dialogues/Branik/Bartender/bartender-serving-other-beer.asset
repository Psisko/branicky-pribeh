  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: bartender-serving-other-beer
  m_EditorClassIdentifier: 
  entryLines:
  - text: "Nazdar Branice, tak to vid\xED\u0161, zase tady mus\xEDm to\u010Dit tuhle
      be\u010Dku. Nev\xED\u0161 jestli u\u017E m\xE1me spraven\xE9 v\u0161echny stroje?"
    speakerName: "Hospodsk\xFD Honza"
  - text: "Ahoj Honzo, je\u0161t\u011B bohu\u017Eel ne."
    speakerName: Branice
  - text: "Himl hergot, tak mi dej v\u011Bd\u011Bt, a\u017E budou stroje budou spraven\xE9,
      d\xE1me si hnedka jedno \u010Derstv\u011B to\u010Den\xFD na oslavu."
    speakerName: "Hospodsk\xFD Honza"
  choices: []
