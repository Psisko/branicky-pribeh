  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: krystof-after-plzen
  m_EditorClassIdentifier: 
  entryLines:
  - text: "Branice! Tys to zvl\xE1dla."
    speakerName: "Kry\u0161tof"
  - text: "Kry\u0161tofe, co to m\u011Blo znamenat, pro\u010D si m\u011B tam nechal.
      Byl tam ob\u0159\xED drak a.."
    speakerName: Branice
  - text: "My jsme to zvl\xE1dli!"
    speakerName: "Kry\u0161tof"
  - text: "A j\xE1..."
    speakerName: "Kry\u0161tof"
  - text: "J\xE1 to dok\xE1zal!"
    speakerName: "Kry\u0161tof"
  - text: "Samoz\u0159ejm\u011B s tvoj\xED pomoc\xED.."
    speakerName: "Kry\u0161tof"
  - text: "Kone\u010Dn\u011B se te\u010F nikdo Bran\xEDku sm\xE1t nebude. HAHAHAHAHHAAH"
    speakerName: "Kry\u0161tof"
  - text: "Pros\xEDmt\u011B, sly\u0161el jsem ale n\u011Bco o n\u011Bjak\xE9m pivu
      Heineken, kter\xE9 se sem dost\xE1v\xE1 ze zahrani\u010D\xED, co \u0159\xEDk\xE1\u0161
      na to, \u017Ee bychom si ud\u011Blali spole\u010Dn\xFD v\xFDlet do zahrani\u010D\xED
      a nav\u0161\xEDvili jejich pivovar, jen my dva?"
    speakerName: "Kry\u0161tof"
  choices:
  - choiceText: "Odjet z Kry\u0161tofem do zahrani\u010D\xED"
    isEnding: 1
    output: exit
    dialogue:
    - text: "No jasn\u011B Kry\u0161tofe, s tebou j\xE1 p\u016Fjdu kamkoliv <3"
      speakerName: Branice
  - choiceText: "Opustit Kry\u0161tofa"
    isEnding: 1
    output: exit
    dialogue:
    - text: "Ehm to mysl\xED\u0161 v\xE1\u017En\u011B?"
      speakerName: Branice
    - text: "V\u017Edy\u0165 si m\u011B poslal samotnou bojovat proti drakovi a s\xE1m
        si utekl."
      speakerName: Branice
    - text: "Sbohem Kry\u0161tofe, u\u017E se nenech\xE1m takhle zneu\u017E\xEDvat."
      speakerName: Branice
  participantPortrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
  monologue: 0
