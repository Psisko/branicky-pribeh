  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: krystof-first-time-in-branik
  m_EditorClassIdentifier: 
  entryLines:
  - text: "Branice, m\u016F\u017Ee\u0161 se te\u010F porozhl\xE9dnout po pivovaru."
    speakerName: "Kry\u0161tof"
  - text: "M\u016F\u017Ee\u0161 si promluvit se zam\u011Bstnanci nebo koupit za v\xED\u010Dka
      nov\xE9 stroje. A\u017E budeme m\xEDt v\u0161echny stroje opraven\xE9, pivovar
      za\u010Dne znovu kone\u010Dn\u011B fungovat!"
    speakerName: "Kry\u0161tof"
  - text: "A\u017E t\u011B to p\u0159estane bavit, tak se stav na slov\xED\u010Dko.
      Najde\u0161 m\u011B v horn\xEDm pat\u0159e, do kter\xE9ho se dostanes pomoc\xED
      dve\u0159\xED co vid\xED\u0161 napravo. "
    speakerName: "Kry\u0161tof"
  choices: []
  participantPortrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
  monologue: 0
