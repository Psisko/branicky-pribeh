  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: kvasnik-branik-broken
  m_EditorClassIdentifier: 
  entryLines:
  - text: "Pro\u010D se tady jen tak fl\xE1k\xE1\u0161?"
    speakerName: Branice
  - text: "*p\xEDska si Br\xE1na song*"
    speakerName: "Kvasn\xEDk V\xE1clav"
  - text: "Neru\u0161\xEDm t\u011B?"
    speakerName: Branice
  - text: "Aaaa nazdar Br\xE1nice, docela si m\u011B vylekala"
    speakerName: "Kvasn\xEDk V\xE1clav"
  - text: "Co tady d\u011Bl\xE1\u0161? Nem\xE1\u0161 si hl\xEDdat kvasnice?"
    speakerName: Branice
  - text: "Jo, no to j\xE1 bych r\xE1d, ta v\u016Fn\u011B mi stra\u0161n\u011B chyb\xED,
      ale v\u0161echny stroje je\u0161t\u011B nejsou opraven\xE9 a j\xE1 se tady
      stra\u0161n\u011B nud\xEDm."
    speakerName: "Kvasn\xEDk V\xE1clav"
  - text: "Nev\xED\u0161 n\xE1hodou kdy u\u017E to bude?"
    speakerName: "Kvasn\xEDk V\xE1clav"
  - text: "Nev\xEDm, ale v\u011B\u0159\xEDm, \u017Ee u\u017E to bude brzy, pivovaru
      se pr\xFD za\u010D\xEDn\xE1 zase da\u0159it"
    speakerName: Branice
  - text: "To douf\xE1m, u\u017E se tady opravdu nud\xEDm."
    speakerName: "Kvasn\xEDk V\xE1clav"
  choices: []
