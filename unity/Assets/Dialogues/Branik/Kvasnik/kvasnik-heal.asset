  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: kvasnik-heal
  m_EditorClassIdentifier: 
  entryLines:
  - text: "Ob\u010Das zkou\u0161\xEDm n\u011Bjak\xE9 nov\xE9 receptury bokem, kdy\u017E
      te\u010Fka nem\xE1m co d\u011Blat a posledn\xED v\xE1rka se mi fakt poda\u0159ila.
      V\u011B\u0159\xEDm, \u017Ee by ti mohl dodat na dal\u0161\xED misi n\u011Bjakou
      s\xEDlu. Nechce\u0161 si jeden vz\xEDt?"
    speakerName: "Kvasn\xEDk V\xE1clav"
  choices:
  - choiceText: "Jasn\u011B!"
    isEnding: 1
    output: giveDmgPotion
    dialogue:
    - text: "To zkus\xEDm velmi r\xE1da, d\xEDky moc."
      speakerName: Branice
    - text: "M\u016F\u017Ee\u0161 ho pou\u017E\xEDt pomoc\xED kl\xE1vesy R a na chv\xEDli
        ti dod\xE1 dvojit\xE9 po\u0161kozen\xED tv\xFDch \xFAtok\u016F."
      speakerName: "Kvasn\xEDk V\xE1clav"
  - choiceText: "Te\u010F ne."
    isEnding: 1
    output: 
    dialogue:
    - text: "Te\u010Fka ne, mo\u017En\xE1 jindy?"
      speakerName: Branice
    - text: "Bez probl\xE9mu d\u011Bv\u010De, budu tady na tebe \u010Dekat."
      speakerName: "Kvasn\xEDk V\xE1clav"
  participantPortrait: {fileID: 21300000, guid: a2b1f63327e8dba4db976c810ab9ab12, type: 3}
  monologue: 0
