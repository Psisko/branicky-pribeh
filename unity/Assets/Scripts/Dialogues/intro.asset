%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e95750f108e433543aef0099027763ad, type: 3}
  m_Name: intro
  m_EditorClassIdentifier: 
  entryLines:
  - text: "Kone\u010Dn\u011B p\u0159inesli pivo."
    speakerName: "Kry\u0161tof"
    portrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
    audio: {fileID: 0}
  - text: "Jak \u017Ee se to tu jmenuje?"
    speakerName: Branice
    portrait: {fileID: 21300000, guid: 669aaa38aa0f8f244aa3ca8c5d6b8375, type: 3}
    audio: {fileID: 0}
  - text: "\xDAn\u011Btice, v\u017Edy\u0165 jsem ti to \u0159\xEDkal. Je to n\xE1\u0161
      konkurent. Je\u0161t\u011B chv\xEDli tu budeme sed\u011Bt a pozorovat obsluhu.
      Mus\xEDme b\xFDt p\u0159ipraveni na v\u0161echno. N\xE1\u0161 pl\xE1n nesm\xED
      selhat."
    speakerName: "Kry\u0161tof"
    portrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
    audio: {fileID: 0}
  choices:
  - choiceText: "Pl\xE1n"
    isEnding: 0
    output: 
    dialogue:
    - text: "Jak\xFD \u017Ee je ten pl\xE1n?"
      speakerName: Branice
      portrait: {fileID: 21300000, guid: 669aaa38aa0f8f244aa3ca8c5d6b8375, type: 3}
      audio: {fileID: 0}
    - text: "P\u0159i\u0161li jsme to tady v\u0161echno zni\u010Dit, vzpom\xEDn\xE1\u0161?"
      speakerName: "Kry\u0161tof"
      portrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
      audio: {fileID: 0}
    - text: "No jo! To je dost jednoduch\xFD pl\xE1n."
      speakerName: Branice
      portrait: {fileID: 21300000, guid: 669aaa38aa0f8f244aa3ca8c5d6b8375, type: 3}
      audio: {fileID: 0}
  - choiceText: "Hnusn\xFD pivo"
    isEnding: 0
    output: 
    dialogue:
    - text: "Maj tady p\u011Bkn\u011B hnusn\xFD pivo mus\xEDm \u0159\xEDct."
      speakerName: Branice
      portrait: {fileID: 21300000, guid: 669aaa38aa0f8f244aa3ca8c5d6b8375, type: 3}
      audio: {fileID: 0}
    - text: "No to maj\xED. Proto to tady chci rozml\xE1tit na mad\u011Bru..."
      speakerName: "Kry\u0161tof"
      portrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
      audio: {fileID: 0}
  - choiceText: "J\xE1 to tady rozbiju!"
    isEnding: 1
    output: destroy
    dialogue:
    - text: "Ugh. Tady to u\u017E nevydr\u017E\xEDm. Jdu to v\u0161echno rozml\xE1tit."
      speakerName: Branice
      portrait: {fileID: 21300000, guid: 669aaa38aa0f8f244aa3ca8c5d6b8375, type: 3}
      audio: {fileID: 0}
    - text: "Ale jen si poslu\u017Ete, paninko."
      speakerName: "Kry\u0161tof"
      portrait: {fileID: 21300000, guid: acbefb7de517d05429e8f76e1b6e54a5, type: 3}
      audio: {fileID: 0}
